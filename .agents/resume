#!/usr/bin/env bash
set -euo pipefail

# Fast, idempotent wake-up checks only. Do not install dependencies here.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

source_dir="$(cd "$repo_root/.." && pwd)/magpie-main"
if [ ! -d "$source_dir/.git" ] && [ ! -f "$source_dir/.git" ]; then
  echo "[orb-resume] NOTE: missing source tree $source_dir (run .agents/setup)"
fi

mkdir -p .amp
date -u +%Y-%m-%dT%H:%M:%SZ > .amp/resume-last-ran.txt

echo "[orb-resume] Complete"
