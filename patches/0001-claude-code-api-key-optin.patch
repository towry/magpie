+func TestClaudeAPIKeyServesThroughClaudeCode(t *testing.T) {
+	fakeClaude(t)
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	p := provider.Provider{ID: "packy-cc", Name: "Packy", Key: "sk-test", Anthropic: "https://cf.api.fan", ClaudeCode: true, Models: []string{"claude-haiku-5-5"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	s := New()
+	t.Cleanup(s.subscription.abortAll)
+	body := `{"model":"packy-cc/claude-haiku-5-5","max_tokens":100,"messages":[{"role":"user","content":"hi"}]}`
+	code, reply := sendTo(s, "/v1/messages", body)
+	if code != 200 || !strings.Contains(reply, "pid ") {
+		t.Fatalf("opt-in reply: %d %s", code, reply)
+	}
+}
+
+func TestClaudeAPIKeyUsesWireModel(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("a shell script stands in for Claude Code")
+	}
+	dir := t.TempDir()
+	script := `#!/bin/sh
+model=""
+for a in "$@"; do
+  if [ "$prev" = "--model" ]; then model="$a"; fi
+  prev="$a"
+done
+read -r line
+echo "{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"id\":\"m\",\"model\":\"$model\",\"usage\":{\"input_tokens\":1}}}}"
+echo "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"model $model\"}}}"
+echo '{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"output_tokens":1}}}'
+echo '{"type":"stream_event","event":{"type":"message_stop"}}'
+echo '{"type":"result","subtype":"success","is_error":false,"result":""}'
+`
+	testenv.Program(t, filepath.Join(dir, "claude"), script)
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	if err := settings.Save(settings.Settings{ModelWires: map[string]string{"packy-cc/claude-haiku-5-5": "claude-haiku-4-5"}}); err != nil {
+		t.Fatal(err)
+	}
+	p := provider.Provider{ID: "packy-cc", Name: "Packy", Key: "sk-test", Anthropic: "https://cf.api.fan", ClaudeCode: true, Models: []string{"claude-haiku-5-5"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	s := New()
+	t.Cleanup(s.subscription.abortAll)
+	body := `{"model":"packy-cc/claude-haiku-5-5","max_tokens":100,"messages":[{"role":"user","content":"hi"}]}`
+	code, reply := sendTo(s, "/v1/messages", body)
+	if code != 200 || !strings.Contains(reply, "model claude-haiku-4-5") {
+		t.Fatalf("wire model: %d %s", code, reply)
+	}
+}
+
+func TestClaudeAPIKeyCountTokensIsLocal(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	p := provider.Provider{ID: "packy-cc", Name: "Packy", Key: "sk-test", Anthropic: "https://example.invalid", ClaudeCode: true, Models: []string{"claude-haiku-5-5"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	code, body := post(t, "/v1/messages/count_tokens", `{"model":"packy-cc/claude-haiku-5-5","messages":[{"role":"user","content":"hi there"}]}`)
+	var got struct {
+		Tokens int `json:"input_tokens"`
+	}
+	if err := json.Unmarshal([]byte(body), &got); err != nil || code != 200 || got.Tokens <= 0 {
+		t.Fatalf("local count: %d %s (decode: %v)", code, body, err)
+	}
+}
+
+func TestHTTPProviderStillGoesHTTP(t *testing.T) {
+	f := &fake{ctype: "application/json", reply: `{"id":"m","type":"message","role":"assistant","content":[{"type":"text","text":"http"}],"stop_reason":"end_turn","usage":{"input_tokens":1,"output_tokens":1}}`}
+	setup(t, provider.Anthropic, f)
+	code, body := post(t, "/v1/messages", `{"model":"fake/m1","max_tokens":10,"messages":[{"role":"user","content":"hi"}]}`)
+	if code != 200 || !strings.Contains(body, "http") || f.calls == 0 {
+		t.Fatalf("ordinary HTTP: %d %s calls=%d", code, body, f.calls)
+	}
+}
