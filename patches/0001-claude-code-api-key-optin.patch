@@ -0,0 +1,32 @@
+package provider
+
+import "testing"
+
+func TestUsesClaudeCodeOnlyOnAPIKeyProviders(t *testing.T) {
+	p := Provider{ID: "packy-cc", Anthropic: "https://cf.api.fan", Key: "sk-test", ClaudeCode: true}
+	if !p.UsesClaudeCode() {
+		t.Fatal("opt-in API-key provider must use Claude Code")
+	}
+	p.Account = &Account{Agent: "claude", User: "u@example.com"}
+	if p.UsesClaudeCode() {
+		t.Fatal("a signed-in Claude subscription must not take the API-key opt-in")
+	}
+	q := Provider{ID: "relay", Anthropic: "https://cf.api.fan", Key: "sk-test"}
+	if q.UsesClaudeCode() {
+		t.Fatal("default is ordinary HTTP")
+	}
+}
+
+func TestClaudeCodeFlagRoundTrip(t *testing.T) {
+	p := Provider{ID: "packy-cc", Name: "Packy", Anthropic: "https://cf.api.fan", Key: "sk-test", ClaudeCode: true, Models: []string{"claude-haiku-5-5"}}
+	if err := Save(p); err != nil {
+		t.Fatal(err)
+	}
+	got, err := Find("packy-cc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !got.ClaudeCode || got.Key != "sk-test" || got.Anthropic != "https://cf.api.fan" {
+		t.Fatalf("saved: %+v", got)
+	}
+}
