+// claudeAPIKeyOwner is a run owner that ownerAccount will not take as a
+// subscription user: no NUL, so the second field is empty.
+func claudeAPIKeyOwner(p provider.Provider) string {
+	id := provider.KeyID(p.Key)
+	if id == "" {
+		id = "nokey"
+	}
+	ep := provider.KeyID(strings.TrimSpace(p.Anthropic))
+	if ep == "" {
+		ep = "noep"
+	}
+	return p.ID + "#key#" + id + "#ep#" + ep
+}
+
+func claudeAPIKeyConfigDir(p provider.Provider) (string, error) {
+	dir := filepath.Join(appdir.Cache(), "claude-code", claudeAPIKeyOwner(p))
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return "", err
+	}
+	return dir, nil
+}
+
+func claudeAPIKeyEnv(p provider.Provider) ([]string, error) {
+	key := strings.TrimSpace(p.Key)
+	if key == "" {
+		return nil, errors.New("Claude Code needs an API key")
+	}
+	base := strings.TrimSpace(p.Anthropic)
+	if base == "" {
+		return nil, errors.New("Claude Code needs an Anthropic base URL")
+	}
+	return []string{"ANTHROPIC_BASE_URL=" + base, "ANTHROPIC_API_KEY=" + key}, nil
+}
+
+func (s *Server) serveClaudeAPIKey(w http.ResponseWriter, r *http.Request, from provider.Protocol, p provider.Provider, model string, body []byte, usage *Usage) (int, string) {
+	owner := claudeAPIKeyOwner(p)
+	wire := provider.UpstreamNameIn(wiresOf(r.Context()), p.ID, model)
+	start := func(ctx context.Context, req *Request) (*subscriptionRun, <-chan Event, error) {
+		ctx = p.Via(ctx)
+		if run, events := s.subscription.resume(req, owner); run != nil {
+			return run, events, nil
+		}
+		from := s.subscription.unshelve(req, owner)
+		s.subscription.retire(owner, req.Messages)
+		if req.Effort == "" && autoModeClassifier(req) {
+			req.Effort = "low"
+		}
+		extra, err := claudeAPIKeyEnv(p)
+		if err != nil {
+			if from != nil {
+				from.discard()
+			}
+			return nil, nil, err
+		}
+		dir, err := claudeAPIKeyConfigDir(p)
+		if err != nil {
+			if from != nil {
+				from.discard()
+			}
+			return nil, nil, err
+		}
+		return s.subscription.startWith(ctx, req, wire, dir, owner, from, extra)
+	}
+	return s.serveSubscription(w, r, from, "Claude Code", model, owner, body, usage, start)
+}
