+
+func TestClaudeAPIKeyOwnerIsNotASubscriptionUser(t *testing.T) {
+	p := provider.Provider{ID: "packy-cc", Key: "sk-test"}
+	owner := claudeAPIKeyOwner(p)
+	if strings.Contains(owner, "\x00") {
+		t.Fatalf("owner %q looks like a subscription account", owner)
+	}
+	if user, own := ownerAccount(owner); user != "" || own {
+		t.Fatalf("ownerAccount(%q) = %q %v", owner, user, own)
+	}
+	other := claudeAPIKeyOwner(provider.Provider{ID: "packy-cc", Key: "sk-other"})
+	if owner == other {
+		t.Fatal("different keys must not share a Claude Code process")
+	}
+	moved := claudeAPIKeyOwner(provider.Provider{ID: "packy-cc", Key: "sk-test", Anthropic: "https://other.example"})
+	if owner == moved {
+		t.Fatal("different endpoints must not share a Claude Code process")
+	}
+}
+
+func TestClaudeAPIKeyEnvNeedsKeyAndEndpoint(t *testing.T) {
+	_, err := claudeAPIKeyEnv(provider.Provider{ID: "packy-cc", Anthropic: "https://cf.api.fan"})
+	if err == nil || !strings.Contains(err.Error(), "API key") {
+		t.Fatalf("missing key: %v", err)
+	}
+	_, err = claudeAPIKeyEnv(provider.Provider{ID: "packy-cc", Key: "sk-test"})
+	if err == nil || !strings.Contains(err.Error(), "base URL") {
+		t.Fatalf("missing endpoint: %v", err)
+	}
+	env, err := claudeAPIKeyEnv(provider.Provider{ID: "packy-cc", Key: "sk-test", Anthropic: "https://cf.api.fan"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	joined := strings.Join(env, "\n")
+	if !strings.Contains(joined, "ANTHROPIC_BASE_URL=https://cf.api.fan") || !strings.Contains(joined, "ANTHROPIC_API_KEY=sk-test") {
+		t.Fatalf("env %q", joined)
+	}
+	cleaned := strings.Join(cleanClaudeEnv([]string{"ANTHROPIC_BASE_URL=http://127.0.0.1:1", "ANTHROPIC_API_KEY=from-server", "PATH=/bin"}), "\n")
+	if strings.Contains(cleaned, "ANTHROPIC_BASE_URL=") || strings.Contains(cleaned, "ANTHROPIC_API_KEY=") {
+		t.Fatalf("cleanClaudeEnv kept server overrides: %q", cleaned)
+	}
+	after := append(cleanClaudeEnv([]string{"PATH=/bin"}), env...)
+	got := strings.Join(after, "\n")
+	if !strings.Contains(got, "ANTHROPIC_BASE_URL=https://cf.api.fan") || !strings.Contains(got, "ANTHROPIC_API_KEY=sk-test") {
+		t.Fatalf("opt-in env lost after clean: %q", got)
+	}
+}
+
+func TestClaudeAPIKeyConfigDirIsPrivate(t *testing.T) {
+	p := provider.Provider{ID: "packy-cc", Key: "sk-test"}
+	dir, err := claudeAPIKeyConfigDir(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := filepath.Join(appdir.Cache(), "claude-code", claudeAPIKeyOwner(p))
+	if dir != want {
+		t.Fatalf("dir %q, want %q", dir, want)
+	}
+	if strings.Contains(dir, filepath.Join(os.Getenv("HOME"), ".claude")) {
+		t.Fatalf("must not use the user's Claude config: %q", dir)
+	}
+}
+
+func TestClaudeAPIKeyMissingCLIDoesNotFallBack(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("a shell script stands in for Claude Code")
+	}
+	empty := t.TempDir()
+	t.Setenv("PATH", empty)
+	t.Setenv("HOME", empty)
+	t.Setenv("USERPROFILE", empty)
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	p := provider.Provider{ID: "packy-cc", Name: "Packy", Key: "sk-test", Anthropic: "https://cf.api.fan", ClaudeCode: true, Models: []string{"claude-haiku-5-5"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	body := `{"model":"packy-cc/claude-haiku-5-5","max_tokens":10,"messages":[{"role":"user","content":"hi"}]}`
+	code, reply := post(t, "/v1/messages", body)
+	if code != 502 || !strings.Contains(reply, "Claude Code is not installed") {
+		t.Fatalf("missing CLI: %d %s", code, reply)
+	}
+	if strings.Contains(reply, "auth login") {
+		t.Fatalf("must not hint at a subscription login: %s", reply)
+	}
+}
