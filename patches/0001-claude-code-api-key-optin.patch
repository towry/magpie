+// claudeAPIKeyOwner is a run owner that ownerAccount will not take as a
+// subscription user: no NUL, so the second field is empty.
+func claudeAPIKeyOwner(p provider.Provider) string {
+	id := provider.KeyID(p.Key)
+	if id == "" {
+		id = "nokey"
+	}
+	ep := provider.KeyID(strings.TrimSpace(p.Anthropic))
+	if ep == "" {
+		ep = "noep"
+	}
+	return p.ID + "#key#" + id + "#ep#" + ep
+}
+
+func claudeAPIKeyConfigDir(p provider.Provider) (string, error) {
+	dir := filepath.Join(appdir.Cache(), "claude-code", claudeAPIKeyOwner(p))
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return "", err
+	}
+	return dir, nil
+}
