+// claudeAPIKeyBearer uses the configured Bearer choice only for a third-party
+// Anthropic endpoint. BothAuth's host can be another API's, so classify the
+// actual Anthropic host too, with its port removed.
+func claudeAPIKeyBearer(p provider.Provider) bool {
+	if p.AuthHeader != provider.AuthBearer || p.Account != nil {
+		return false
+	}
+	u, err := url.Parse(strings.TrimSpace(p.Anthropic))
+	if err != nil || u.Scheme == "" || u.Hostname() == "" {
+		return false
+	}
+	host := strings.TrimSuffix(strings.ToLower(u.Hostname()), ".")
+	if provider.AzureHost(host) || host == "aiplatform.googleapis.com" ||
+		strings.HasSuffix(host, "-aiplatform.googleapis.com") ||
+		strings.HasPrefix(host, "aiplatform.") && strings.HasSuffix(host, ".rep.googleapis.com") {
+		return false
+	}
+	actual := provider.Provider{Key: p.Key, Anthropic: "https://" + host}
+	return actual.BothAuth()
+}
+
+func claudeAPIKeyEnv(p provider.Provider) ([]string, error) {
+	key := strings.TrimSpace(p.Key)
+	if key == "" {
+		return nil, errors.New("Claude Code needs an API key")
+	}
+	base := strings.TrimSpace(p.Anthropic)
+	if base == "" {
+		return nil, errors.New("Claude Code needs an Anthropic base URL")
+	}
+	name := "ANTHROPIC_API_KEY="
+	if claudeAPIKeyBearer(p) {
+		name = "ANTHROPIC_AUTH_TOKEN="
+	}
+	return []string{"ANTHROPIC_BASE_URL=" + base, name + key}, nil
+}
+
+func (s *Server) serveClaudeAPIKey(w http.ResponseWriter, r *http.Request, from provider.Protocol, p provider.Provider, model string, body []byte, usage *Usage) (int, string) {
+	extra, envErr := claudeAPIKeyEnv(p)
+	owner := claudeAPIKeyOwner(p)
+	if len(extra) > 1 && strings.HasPrefix(extra[1], "ANTHROPIC_AUTH_TOKEN=") {
+		// A run or parked tool call must keep the authentication it began with.
+		// The configuration directory stays the same across this change.
+		owner += "#auth#bearer"
+	} else if len(extra) > 1 && strings.HasPrefix(extra[1], "ANTHROPIC_API_KEY=") {
+		// This bridge was explicitly enabled for the provider's configured key.
+		extra = append(extra, claudetui.ApproveAPIKeyEnv+"=1")
+	}
+	wire := provider.UpstreamNameIn(wiresOf(r.Context()), p.ID, model)
+	start := func(ctx context.Context, req *Request) (*subscriptionRun, <-chan Event, error) {
+		ctx = p.Via(ctx)
+		if run, events := s.subscription.resume(req, owner); run != nil {
+			return run, events, nil
+		}
+		from := s.subscription.unshelve(req, owner)
+		s.subscription.retire(owner, req)
+		if req.Effort == "" && autoModeClassifier(req) {
+			req.Effort = "low"
+		}
+		if envErr != nil {
+			if from != nil {
+				from.discard()
+			}
+			return nil, nil, envErr
+		}
+		dir, err := claudeAPIKeyConfigDir(p)
+		if err != nil {
+			if from != nil {
+				from.discard()
+			}
+			return nil, nil, err
+		}
+		return s.subscription.startWith(ctx, req, wire, dir, owner, from, extra)
+	}
+	return s.serveSubscription(w, r, from, "Claude Code", model, owner, body, usage, start)
+}
