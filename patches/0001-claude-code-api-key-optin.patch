 func (p Provider) On() bool { return p.Ready() && !p.Off }
 
+// UsesClaudeCode is a custom API-key provider that opted in to the genuine
+// Claude Code binary. A subscription (Account set) never does: it already
+// has its own bridge, and this flag must not fake one.
+func (p Provider) UsesClaudeCode() bool {
+	return p.ClaudeCode && p.Account == nil
+}
